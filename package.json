{
  "name": "foliantica",
  "version": "2.0.1",
  "description": "Foliantica Personal Studio — local-first novel writing app",
  "author": "Foliantica",
  "main": "electron/main.js",
  "scripts": {
    "generate-icons": "cd scripts && npm install && node generate-icons.mjs",
    "electron:dev": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.4",
    "embedded-postgres": "^17.7.0-beta.16"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  }
}
